# Worker uses environment variables from the workspace root
# Located at: ../../.env.local
#
# Required variables:
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
# - OPENAI_API_KEY
# - OPENAI_KNOWLEDGE_MODEL
# - OPENAI_VISUAL_MODEL
# - OPENAI_EMBEDDING_MODEL
#
# Optional worker-specific variables:
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_MAX_RETRY_ATTEMPTS=3
WORKER_JOB_TIMEOUT_MS=300000
WORKER_STAGE_TIMEOUT_MS=60000
WORKER_RETRY_INITIAL_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=60000
WORKER_RETRY_BACKOFF_MULTIPLIER=2
WORKER_DETAILED_LOGGING=false
WORKER_ENABLE_METRICS=false

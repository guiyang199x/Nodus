{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@knowledge/domain": [
        "../../packages/domain/src"
      ],
      "@knowledge/domain/*": [
        "../../packages/domain/src/*"
      ],
      "@knowledge/ai": [
        "../../packages/ai/src"
      ],
      "@knowledge/ai/*": [
        "../../packages/ai/src/*"
      ],
      "@knowledge/observability": [
        "../../packages/observability/src"
      ],
      "@knowledge/observability/*": [
        "../../packages/observability/src/*"
      ]
    },
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

# Supabase Configuration
# Local Development: Use values from `supabase status`
# Production: Use values from Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web application
# Absolute origin used to build the auth callback URL. Must be an exact
# entry in supabase/config.toml additional_redirect_urls.
APP_URL=http://127.0.0.1:3000

# Invitation email delivery (Plan 01 Task 6)
# Leave RESEND_API_KEY empty for local development: invitation email then
# goes to the same local mail catcher as sign-in email, readable at
# http://127.0.0.1:54324. Set it in staging and production.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=知识工作台 <invites@example.test>
# Local mail catcher SMTP, only used when RESEND_API_KEY is empty.
LOCAL_SMTP_HOST=127.0.0.1
LOCAL_SMTP_PORT=54325

# Database URL
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: Use connection string from Supabase
DATABASE_URL=your-database-url

# OpenAI-compatible provider (DeepSeek by default for local development)
# Get a key: https://platform.deepseek.com/api_keys
# Official base URL: https://api.deepseek.com
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_KNOWLEDGE_MODEL=deepseek-v4-pro
OPENAI_VISUAL_MODEL=deepseek-v4-flash-vision-exp
# DeepSeek has no embeddings API. Keep a separate embedding model ID for Plan 02.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage Configuration (S3-compatible)
# Local Development: Use values from `supabase status`
SUPABASE_STORAGE_URL=http://127.0.0.1:54321/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=your-storage-access-key
SUPABASE_STORAGE_SECRET_KEY=your-storage-secret-key
SUPABASE_STORAGE_REGION=local

# Environment
NODE_ENV=development

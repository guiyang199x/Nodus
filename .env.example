# Supabase Configuration
# Local Development: Use values from `supabase status`
# Production: Use values from Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google sign-in (optional locally, real in staging and production).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with authorised redirect URI http://127.0.0.1:54321/auth/v1/callback, then
# set enabled = true under [auth.external.google] in supabase/config.toml and
# restart Supabase. Leave blank to sign in with an email link instead.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Web application
# Absolute origin used to build the auth callback URL. Must be an exact
# entry in supabase/config.toml additional_redirect_urls.
APP_URL=http://127.0.0.1:3000

# Invitation email delivery (Plan 01 Task 6)
# Leave RESEND_API_KEY empty for local development: invitation email then
# goes to the same local mail catcher as sign-in email, readable at
# http://127.0.0.1:54324. Set it in staging and production.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=知识工作台 <invites@example.test>
# Local mail catcher SMTP, only used when RESEND_API_KEY is empty.
LOCAL_SMTP_HOST=127.0.0.1
LOCAL_SMTP_PORT=54325

# Database URL
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: Use connection string from Supabase
DATABASE_URL=your-database-url

# Knowledge analysis and visual extraction (OpenAI-compatible).
# DeepSeek by default: https://platform.deepseek.com/api_keys
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_KNOWLEDGE_MODEL=deepseek-v4-pro
OPENAI_VISUAL_MODEL=deepseek-v4-flash-vision-exp

# Vector embeddings — a SEPARATE provider.
# DeepSeek publishes no embeddings endpoint, so hybrid search cannot use the
# block above. Qwen on Alibaba Bailian is OpenAI-compatible:
# https://bailian.console.aliyun.com/
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v4
# Written into the vector(N) column by the hybrid-search migration. Changing it
# later means rebuilding the index and re-embedding every chunk, so decide once.
EMBEDDING_DIMENSIONS=1024

# Storage Configuration (S3-compatible)
# Local Development: Use values from `supabase status`
SUPABASE_STORAGE_URL=http://127.0.0.1:54321/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=your-storage-access-key
SUPABASE_STORAGE_SECRET_KEY=your-storage-secret-key
SUPABASE_STORAGE_REGION=local

# Environment
NODE_ENV=development
